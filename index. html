<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My AI Search Engine</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #0f172a;
      color: #f8fafc;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
      margin: 0;
    }
    .container {
      width: 100%;
      max-width: 700px;
    }
    h1 {
      text-align: center;
      color: #38bdf8;
    }
    .key-box, .search-box {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    input {
      flex: 1;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #334155;
      background: #1e293b;
      color: white;
      font-size: 16px;
    }
    button {
      padding: 12px 20px;
      border-radius: 8px;
      border: none;
      background: #38bdf8;
      color: #0f172a;
      font-weight: bold;
      cursor: pointer;
      font-size: 16px;
    }
    button:hover {
      background: #0284c7;
      color: white;
    }
    #answer-box {
      background: #1e293b;
      padding: 20px;
      border-radius: 10px;
      min-height: 100px;
      line-height: 1.6;
      white-space: pre-wrap;
      border: 1px solid #334155;
    }
    .note {
      font-size: 12px;
      color: #94a3b8;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>AI Search Engine</h1>
    
    <div class="key-box">
      <input type="password" id="apiKey" placeholder="Paste your free Gemini API Key here...">
      <button onclick="saveKey()">Save Key</button>
    </div>
    <div class="note">Your key is saved only inside your own browser, never uploaded to GitHub.</div>

    <div class="search-box">
      <input type="text" id="query" placeholder="Ask any question..." onkeypress="if(event.key==='Enter') askAI()">
      <button onclick="askAI()">Search</button>
    </div>

    <div id="answer-box">Your AI answer will appear here...</div>
  </div>

  <script>
    document.getElementById('apiKey').value = localStorage.getItem('gemini_api_key') || '';

    function saveKey() {
      const key = document.getElementById('apiKey').value.trim();
      localStorage.setItem('gemini_api_key', key);
      alert('API Key saved in your browser!');
    }

    async function askAI() {
      const apiKey = document.getElementById('apiKey').value.trim();
      const query = document.getElementById('query').value.trim();
      const answerBox = document.getElementById('answer-box');

      if (!apiKey) {
        alert('Please paste and save your free API key first!');
        return;
      }
      if (!query) return;

      answerBox.innerText = 'Thinking...';

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: query }] }]
          })
        });

        const data = await response.json();
        if (data.error) {
          answerBox.innerText = 'Error: ' + data.error.message;
        } else {
          answerBox.innerText = data.candidates[0].content.parts[0].text;
        }
      } catch (err) {
        answerBox.innerText = 'Network error: ' + err.message;
      }
    }
  </script>
</body>
</html>
